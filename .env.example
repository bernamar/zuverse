# Copy this file to .env and paste a key below. Never commit .env.
#
# Own keys: set BOTH of these and Zuverse uses your accounts instead of Zurelay.
# Gemini reads the ad and does the text jobs: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Kie makes the images (GPT Image 2.5) and the video (Seedance 2.5): https://kie.ai
# API docs: https://docs.kie.ai
KIE_API_KEY=

# Or one Zurelay key for every model: https://zurelay.com (API keys).
# Used when the two keys above are not both set.
ZURELAY_API_KEY=zr_live_your_key_here

# Optional: where projects are kept (default ./zuverse-projects)
# ZUVERSE_PROJECTS=./zuverse-projects
